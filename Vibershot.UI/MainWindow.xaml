<Window x:Class="Vibershot.UI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Vibershot" Width="460" Height="365" ResizeMode="CanMinimize"
 Topmost="True" WindowStartupLocation="CenterScreen">
 <Grid Margin="24,18,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal">
    <Border Width="38" Height="38" CornerRadius="11" Background="#263D35" Margin="0,0,12,0"><TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Vibershot" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="A little tool. A clearer picture." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
   </StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#23362F" CornerRadius="10" Padding="9,4"><TextBlock Text="●  Ready" Foreground="{StaticResource Accent}" FontSize="10"/></Border>
  </Grid>
  <Button Grid.Row="1" Style="{StaticResource PrimaryButton}" Click="CaptureButton_Click" AutomationProperties.Name="Capture region" Margin="0,24,0,10" Padding="18,17" HorizontalContentAlignment="Stretch" ToolTip="Select part of your screen (Ctrl+Shift+S)">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="&#xE7C4;" FontFamily="Segoe Fluent Icons" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"/>
    <StackPanel Grid.Column="1"><TextBlock Text="Capture region" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Drag to select any part of your screen" FontSize="11" FontWeight="Normal" Margin="0,3,0,0"/></StackPanel>
    <TextBlock Grid.Column="2" Text="↗" FontSize="23" VerticalAlignment="Center"/>
   </Grid>
  </Button>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Button Click="Fullscreen_Click" AutomationProperties.Name="Full desktop" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Full desktop"/></StackPanel></Button>
   <Button Grid.Column="2" Click="SettingsButton_Click" AutomationProperties.Name="Settings" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Settings"/></StackPanel></Button>
  </Grid>
  <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Your next capture is a shortcut away" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#1E242C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="8,4"><TextBlock Text="Ctrl + Shift + S" FontSize="10" Foreground="#CDD6E0"/></Border></Grid>
  <TextBlock Grid.Row="4" x:Name="StatusLabel" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" Margin="0,12,0,0" FontSize="11" MaxHeight="32" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 </Grid>
</Window>
