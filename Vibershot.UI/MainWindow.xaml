<Window x:Class="Vibershot.UI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Vibershot" Width="452" SizeToContent="Height"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize"
 Topmost="True" WindowStartupLocation="CenterScreen" Foreground="{StaticResource Ink}">
 <Window.Resources>
  <!-- Header chrome: 30px icon-only buttons with a quiet hover fill. -->
  <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Ink2}"/>
   <Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="6">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource Rule}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Tangerine}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Secondary actions: borderless rows separated by space, filled only on hover. -->
  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource Hover}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource Rule}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Tangerine}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/><Setter TargetName="Shell" Property="Padding" Value="12,10"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RowIcon" TargetType="Border">
   <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="CornerRadius" Value="9"/>
   <Setter Property="Background" Value="{StaticResource TangerineSoft}"/><Setter Property="Margin" Value="0,0,14,0"/>
  </Style>
  <Style x:Key="RowGlyph" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="15"/>
   <Setter Property="Foreground" Value="{StaticResource Tangerine}"/>
   <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="RowTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style x:Key="RowHint" TargetType="TextBlock"><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{StaticResource Ink2}"/><Setter Property="Margin" Value="0,2,0,0"/></Style>
  <Style x:Key="Chip" TargetType="Border">
   <Setter Property="BorderBrush" Value="{StaticResource Rule}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="ChipText" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="10.5"/>
   <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
  </Style>
 </Window.Resources>
 <Border Margin="16" CornerRadius="16" Background="{StaticResource Paper}" BorderBrush="{StaticResource PaperEdge}" BorderThickness="1">
  <Border.Effect><DropShadowEffect Color="#14181C" BlurRadius="40" ShadowDepth="10" Opacity="0.22"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <!-- Header: wordmark on the left, window chrome on the right. Empty space drags the window. -->
   <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="22,0,14,0" ToolTip="Drag to move">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource Ink}" Margin="0,0,8,0">
      <TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{StaticResource Paper}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="Vibershot" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
     <TextBlock x:Name="VersionLabel" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Ink3}" Margin="6,1,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="PinButton" Style="{StaticResource ChromeButton}" Content="&#xE718;" Foreground="{StaticResource Tangerine}" Click="Pin_Click" AutomationProperties.Name="Turn off always on top" ToolTip="Always on top · On"/>
     <Button Style="{StaticResource ChromeButton}" Content="&#xE713;" Click="SettingsButton_Click" AutomationProperties.Name="Settings" ToolTip="Settings"/>
     <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
     <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="Close Vibershot" ToolTip="Close Vibershot"/>
    </StackPanel>
   </Grid>

   <!-- Primary action: the only place the accent appears at full strength. -->
   <Button Grid.Row="1" Click="CaptureButton_Click" AutomationProperties.Name="Capture region" Margin="20,4,20,0" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ToolTip="Select part of your screen (Ctrl+Shift+S)">
    <Button.Template><ControlTemplate TargetType="Button">
     <Border x:Name="Shell" CornerRadius="12" Background="{StaticResource Tangerine}" BorderThickness="0" Padding="18,20">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource TangerineDeep}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.85"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Ink}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/><Setter TargetName="Shell" Property="Padding" Value="16,18"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Button.Template>
    <Grid TextElement.Foreground="{StaticResource TangerineInk}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="40" Height="40" CornerRadius="10" Background="#2EFFFFFF" Margin="0,0,12,0">
      <Path Data="M1,8 L1,1 L8,1 M14,1 L21,1 L21,8 M21,14 L21,21 L14,21 M8,21 L1,21 L1,14 M7,7 L15,7 L15,15 L7,15 Z" Stroke="{StaticResource TangerineInk}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Text="Capture region" FontSize="16" FontWeight="Bold"/>
      <TextBlock Text="Drag to select any part of the screen" FontSize="11.5" FontWeight="SemiBold" Opacity="0.85" Margin="0,3,0,0"/>
     </StackPanel>
     <Border Grid.Column="2" Background="#2E000000" CornerRadius="5" Padding="7,4" VerticalAlignment="Center" Margin="10,0,0,0">
      <TextBlock Text="Ctrl+Shift+S" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Normal"/>
     </Border>
    </Grid>
   </Button>

   <TextBlock Grid.Row="2" Text="MORE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Ink3}" Margin="24,18,24,6"/>

   <!-- Secondary actions. Gallery and Editor are placeholders until their windows exist. -->
   <StackPanel Grid.Row="3" Margin="20,0">
    <Button Style="{StaticResource RowButton}" Click="Fullscreen_Click" AutomationProperties.Name="Full desktop" ToolTip="Capture every monitor at once">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource RowIcon}"><TextBlock Style="{StaticResource RowGlyph}" Text="&#xE7F4;"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource RowTitle}" Text="Full desktop"/><TextBlock Style="{StaticResource RowHint}" Text="Every monitor, saved instantly"/></StackPanel>
      <Border x:Name="FullDesktopChip" Grid.Column="2" Style="{StaticResource Chip}" Visibility="Collapsed"><TextBlock Style="{StaticResource ChipText}" Text="PrtScn"/></Border>
     </Grid>
    </Button>
    <Button Style="{StaticResource RowButton}" Margin="0,6,0,0" Click="Gallery_Click" AutomationProperties.Name="Gallery" ToolTip="Browse, search and manage everything you have captured">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource RowIcon}"><TextBlock Style="{StaticResource RowGlyph}" Text="&#xEB9F;"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource RowTitle}" Text="Gallery"/><TextBlock Style="{StaticResource RowHint}" Text="Browse recent captures"/></StackPanel>
     </Grid>
    </Button>
    <Button Style="{StaticResource RowButton}" Margin="0,6,0,0" IsEnabled="False" AutomationProperties.Name="Editor, coming soon" ToolTip="Editor is coming soon">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource RowIcon}" Background="{StaticResource Hover}"><TextBlock Style="{StaticResource RowGlyph}" Text="&#xE70F;" Foreground="{StaticResource Ink3}"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource RowTitle}" Text="Editor" Foreground="{StaticResource Ink2}"/><TextBlock Style="{StaticResource RowHint}" Text="Annotate, crop and blur"/></StackPanel>
      <Border Grid.Column="2" Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}" Text="SOON" FontSize="9.5"/></Border>
     </Grid>
    </Button>
   </StackPanel>

   <!-- Footer: status on the left, output folder on the right. No rule above it. -->
   <Grid Grid.Row="4" Margin="22,16,22,18">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Ink3}" Margin="0,1,7,0" VerticalAlignment="Center"/>
     <TextBlock x:Name="StatusLabel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ink2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </StackPanel>
    <Button Grid.Column="1" Click="OpenFolder_Click" AutomationProperties.Name="Open captures folder" ToolTip="Open the folder where captures are saved" Background="Transparent" BorderThickness="0" Padding="4,2" Margin="10,0,-4,0">
     <Button.Template><ControlTemplate TargetType="Button">
      <Border x:Name="Shell" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter Property="TextElement.Foreground" Value="{StaticResource Tangerine}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Tangerine}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Button.Template>
     <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource Ink}">
      <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
      <TextBlock Text="Open folder" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
   </Grid>
  </Grid>
 </Border>
</Window>
