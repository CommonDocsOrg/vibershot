<Window x:Class="Vibershot.UI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Vibershot" Width="420" Height="270"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize"
 Topmost="True" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="GlassButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#12FFFFFF"/>
   <Setter Property="BorderBrush" Value="#22FFFFFF"/>
   <Setter Property="Padding" Value="14,12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#25FFFFFF"/><Setter TargetName="Shell" Property="BorderBrush" Value="#55FFFFFF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="12"/>
  </Style>
 </Window.Resources>
 <Border Margin="16" CornerRadius="26" BorderThickness="1">
  <Border.Effect><DropShadowEffect Color="#000B12" BlurRadius="24" ShadowDepth="6" Opacity="0.45"/></Border.Effect>
  <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1"><GradientStop Color="#80FFFFFF"/><GradientStop Color="#18FFFFFF" Offset="0.45"/><GradientStop Color="#5072B5C3" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1"><GradientStop Color="#F02D414B"/><GradientStop Color="#F21B2735" Offset="0.48"/><GradientStop Color="#F518202E" Offset="1"/></LinearGradientBrush></Border.Background>
  <Grid>
   <!-- The light is painted once; no animated blur or background capture loop. -->
   <Border CornerRadius="25" IsHitTestVisible="False"><Border.Background><RadialGradientBrush Center="0.1,0" GradientOrigin="0.1,0" RadiusX="1" RadiusY="0.8"><GradientStop Color="#305FDFCF"/><GradientStop Color="#006BE5DB" Offset="1"/></RadialGradientBrush></Border.Background></Border>
   <Grid Margin="18,10,18,12">
    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" ToolTip="Drag to move">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="33" Height="33" CornerRadius="11" Background="#224FE3C3" BorderBrush="#448CE8D2" BorderThickness="1" Margin="0,0,10,0"><TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="#B8FFEB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="vibershot" FontSize="20" FontWeight="SemiBold" Foreground="#F3FAFF"/></StackPanel>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="PinButton" Style="{StaticResource WindowButton}" Content="&#xE718;" Foreground="{StaticResource Accent}" Click="Pin_Click" AutomationProperties.Name="Turn off always on top" ToolTip="Always on top · On"/>
      <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
      <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="Close Vibershot" ToolTip="Close Vibershot"/>
     </StackPanel>
    </Grid>
    <Button Grid.Row="1" Click="CaptureButton_Click" AutomationProperties.Name="Capture region" Margin="0,9,0,8" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ToolTip="Select part of your screen (Ctrl+Shift+S)">
     <Button.Template><ControlTemplate TargetType="Button">
      <Border x:Name="CaptureShell" CornerRadius="19" BorderBrush="#C3FFF4" BorderThickness="1" Padding="14,12">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BCF8E3"/><GradientStop Color="#8FE2D4" Offset="0.5"/><GradientStop Color="#6CC6CD" Offset="1"/></LinearGradientBrush></Border.Background>
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptureShell" Property="Opacity" Value="0.9"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptureShell" Property="Opacity" Value="0.72"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CaptureShell" Property="BorderBrush" Value="White"/><Setter TargetName="CaptureShell" Property="BorderThickness" Value="2"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Button.Template>
     <Grid TextElement.Foreground="#153B37"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="#201C746F" Width="42" Height="42" CornerRadius="13" Margin="0,0,14,0"><Path Data="M1,8 L1,1 L8,1 M14,1 L21,1 L21,8 M21,14 L21,21 L14,21 M8,21 L1,21 L1,14" Stroke="#234F48" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Capture region" FontSize="19" FontWeight="SemiBold"/></StackPanel>
      <TextBlock Grid.Column="2" Text="↗" FontSize="24" VerticalAlignment="Center" Margin="8,0,0,0"/>
     </Grid>
    </Button>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource GlassButton}" Click="Fullscreen_Click" AutomationProperties.Name="Full desktop" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" Foreground="#AFE5DE" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Full desktop" FontSize="12"/></StackPanel></Button>
     <Button Grid.Column="2" Style="{StaticResource GlassButton}" Click="SettingsButton_Click" AutomationProperties.Name="Settings" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="#AFE5DE" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Settings" FontSize="12"/></StackPanel></Button>
    </Grid>
    <TextBlock Grid.Row="4" x:Name="StatusLabel" VerticalAlignment="Top" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#90ABBD" Margin="0,12,0,0" FontSize="10" MaxHeight="30" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   </Grid>
  </Grid>
 </Border>
</Window>
