<Window x:Class="Vibershot.UI.ExportImageWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Export image" Width="720" Height="560" MinWidth="620" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="24,20,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="Export image" FontSize="20" FontWeight="Bold"/>
   <TextBlock Text="Writes a flat picture. The preview shows the file as it will be saved, compression and all." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="236"/></Grid.ColumnDefinitions>
   <!-- Checkerboard well: the decoded preview, so lossy artefacts show at the chosen quality. -->
   <Border CornerRadius="12" BorderBrush="{StaticResource PaperEdge}" BorderThickness="1" Padding="16" ClipToBounds="True">
    <Border.Background>
     <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
       <DrawingGroup>
        <GeometryDrawing Brush="#2C2E3A"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,20,20"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#363947"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,10,10"/><RectangleGeometry Rect="10,10,10,10"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
       </DrawingGroup>
      </DrawingBrush.Drawing>
     </DrawingBrush>
    </Border.Background>
    <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
   </Border>
   <StackPanel Grid.Column="2">
    <TextBlock Text="FORMAT" Style="{StaticResource GroupLabel}" Margin="0,0,0,8"/>
    <ComboBox x:Name="FormatCombo" AutomationProperties.Name="Export format" SelectionChanged="Format_Changed"/>
    <StackPanel x:Name="QualityPanel" Margin="0,16,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Quality" FontWeight="Bold"/><TextBlock x:Name="QualityValue" Grid.Column="1" Foreground="{StaticResource Ink2}" FontFamily="{StaticResource MonoFont}" FontSize="12"/></Grid>
     <Slider x:Name="QualitySlider" AutomationProperties.Name="Quality" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" Margin="0,8,0,0" ValueChanged="Quality_Changed"/>
    </StackPanel>
    <Border Style="{StaticResource Divider}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Estimated size" FontWeight="Bold"/><TextBlock x:Name="SizeValue" Grid.Column="1" Foreground="{StaticResource Ink2}" FontFamily="{StaticResource MonoFont}" FontSize="12" Text="Encoding…"/></Grid>
    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Dimensions" FontWeight="Bold"/><TextBlock x:Name="DimensionsValue" Grid.Column="1" Foreground="{StaticResource Ink2}" FontFamily="{StaticResource MonoFont}" FontSize="12"/></Grid>
    <Border Style="{StaticResource Divider}"/>
    <CheckBox x:Name="OpenFolderCheck" AutomationProperties.Name="Open folder after export" Click="OpenFolder_Click"><TextBlock Text="Open folder after export" FontWeight="Bold"/></CheckBox>
    <TextBlock Style="{StaticResource Hint}" Text="A flat file cannot be edited again. Save a Vibershot project to keep text, shapes and layers." TextWrapping="Wrap" Margin="0,14,0,0"/>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button Content="Cancel" IsCancel="True" Padding="16,9"/>
   <Button x:Name="ExportButton" Content="Export…" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Export_Click" Padding="22,9" Margin="10,0,0,0" ToolTip="Choose where to write the file"/>
  </StackPanel>
 </Grid>
</Window>
