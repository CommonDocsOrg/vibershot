<Window x:Class="Vibershot.UI.PreviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Vibershot Preview" Width="1040" Height="740" MinWidth="620" MinHeight="420" WindowStartupLocation="CenterScreen">
 <Grid Margin="24,18,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Your capture" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="DimensionsLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Copy image" Click="Copy_Click" Padding="18,11"/><Button Content="Save as…" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="10,0,0,0" Padding="22,11"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#0D1116" Padding="20">
   <Image x:Name="CaptureImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
  </Border>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Accent}" FontSize="15" Margin="0,1,10,0"/>
   <TextBlock Grid.Column="1" x:Name="InfoLabel" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" MaxHeight="52" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Grid>
 </Grid>
</Window>
