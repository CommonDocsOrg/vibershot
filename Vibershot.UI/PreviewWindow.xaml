<Window x:Class="Vibershot.UI.PreviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Vibershot Preview" Width="1040" Height="740" MinWidth="620" MinHeight="420" WindowStartupLocation="CenterScreen">
 <Grid Margin="24,20,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="Your capture" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="DimensionsLabel" Foreground="{StaticResource Ink2}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Copy image" Click="Copy_Click" Padding="18,10"/><Button Content="Save as…" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="10,0,0,0" Padding="22,10"/></StackPanel>
  </Grid>
  <!-- A checkerboard well so transparent and white captures both read against the page. -->
  <Border Grid.Row="1" CornerRadius="12" BorderBrush="{StaticResource PaperEdge}" BorderThickness="1" Padding="20" ClipToBounds="True">
   <Border.Background>
    <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
     <DrawingBrush.Drawing>
      <DrawingGroup>
       <GeometryDrawing Brush="#F3F4F6"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,20,20"/></GeometryDrawing.Geometry></GeometryDrawing>
       <GeometryDrawing Brush="#E6E8EC"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,10,10"/><RectangleGeometry Rect="10,10,10,10"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
     </DrawingBrush.Drawing>
    </DrawingBrush>
   </Border.Background>
   <Image x:Name="CaptureImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
  </Border>
  <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Ellipse Width="7" Height="7" Fill="{StaticResource Ok}" Margin="0,1,8,0" VerticalAlignment="Top"/>
   <TextBlock Grid.Column="1" x:Name="InfoLabel" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" FontSize="11.5" FontWeight="SemiBold" MaxHeight="52" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Grid>
 </Grid>
</Window>
