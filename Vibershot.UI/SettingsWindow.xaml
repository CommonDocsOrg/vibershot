<Window x:Class="Vibershot.UI.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="clr-namespace:Vibershot.Core;assembly=Vibershot.Core"
 Style="{StaticResource {x:Type Window}}" Title="Vibershot Settings" Width="560" Height="860" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <Grid Margin="28,20,28,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Make it yours" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Choose what happens after every capture." Foreground="{StaticResource Muted}" Margin="0,6,0,22"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Background="{StaticResource Card}" CornerRadius="12" Padding="20" Margin="0,0,0,14">
    <StackPanel>
     <TextBlock Text="AFTER CAPTURE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <CheckBox x:Name="ActionsCheckbox" Content="Choose screenshot, video or scrolling after selection" Margin="0,0,0,14"/>
     <CheckBox x:Name="SaveDialogCheckbox" Content="Show Save As after taking a screenshot" Margin="0,0,0,14"/>
     <CheckBox x:Name="AutosaveCheckbox" AutomationProperties.Name="Save automatically"><StackPanel><TextBlock Text="Save automatically" FontWeight="SemiBold"/><TextBlock Text="Keep a file of each screenshot" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></CheckBox>
     <Border Height="1" Background="{StaticResource Line}" Margin="0,14"/>
     <CheckBox x:Name="ClipboardCheckbox" AutomationProperties.Name="Copy to clipboard"><StackPanel><TextBlock Text="Copy to clipboard" FontWeight="SemiBold"/><TextBlock Text="Ready to paste wherever you need it" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></CheckBox>
    </StackPanel>
   </Border>
   <Border Background="{StaticResource Card}" CornerRadius="12" Padding="20" Margin="0,0,0,14">
    <StackPanel>
     <TextBlock Text="SYSTEM" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <CheckBox x:Name="StartupCheckbox" AutomationProperties.Name="Start with Windows"><StackPanel><TextBlock Text="Start with Windows" FontWeight="SemiBold"/><TextBlock Text="Launch into the tray when you sign in" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></CheckBox>
     <Border Height="1" Background="{StaticResource Line}" Margin="0,14"/>
     <CheckBox x:Name="PrintScreenCheckbox" AutomationProperties.Name="Take over Print Screen" Checked="PrintScreenCheckbox_Changed" Unchecked="PrintScreenCheckbox_Changed"><StackPanel><TextBlock Text="Take over Print Screen" FontWeight="SemiBold"/><TextBlock Text="Vibershot handles the key instead of Windows while it is running" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></CheckBox>
     <StackPanel x:Name="PrintScreenOptions" Margin="24,12,0,0">
      <RadioButton x:Name="PrintScreenToolRadio" GroupName="PrintScreen" Content="Open the capture region/window tool" Margin="0,0,0,10"/>
      <RadioButton x:Name="PrintScreenDesktopRadio" GroupName="PrintScreen" Content="Snap the full desktop right away"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <Border Background="{StaticResource Card}" CornerRadius="12" Padding="20">
    <StackPanel>
     <TextBlock Text="FILES" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <TextBlock Text="Save location" Margin="0,0,0,7"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderTextBox" AutomationProperties.Name="Save location" ToolTip="Screenshot output folder"/><Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="12,9" Click="BrowseButton_Click"/></Grid>
     <TextBlock Text="Image format" Margin="0,16,0,7"/>
     <ComboBox x:Name="FormatComboBox" AutomationProperties.Name="Image format" SelectionChanged="FormatComboBox_SelectionChanged"><ComboBoxItem Content="PNG · lossless quality" Tag="{x:Static core:ImageFormat.Png}"/><ComboBoxItem Content="JPEG · smaller files" Tag="{x:Static core:ImageFormat.Jpeg}"/><ComboBoxItem Content="WebP lossless · exact pixels, smaller than PNG" Tag="{x:Static core:ImageFormat.WebpLossless}"/><ComboBoxItem Content="WebP · custom quality" Tag="{x:Static core:ImageFormat.Webp}"/></ComboBox>
     <StackPanel x:Name="WebpQualityPanel" Margin="0,12,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="WebP quality"/><TextBlock x:Name="WebpQualityLabel" Grid.Column="1" Foreground="{StaticResource Muted}"/></Grid>
      <Slider x:Name="WebpQualitySlider" AutomationProperties.Name="WebP quality" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" Margin="0,6,0,0" ValueChanged="WebpQualitySlider_ValueChanged"/>
      <TextBlock Text="Lower is smaller; 80 is a good balance" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True" Width="94" Click="CancelButton_Click"/><Button Content="Save settings" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OkButton_Click"/></StackPanel>
 </Grid>
</Window>
