<Window x:Class="Vibershot.UI.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="clr-namespace:Vibershot.Core;assembly=Vibershot.Core"
 Style="{StaticResource {x:Type Window}}" Title="Vibershot Settings" Width="560" Height="860" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource Well}">
 <Grid Margin="28,24,28,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock Text="Settings" FontSize="22" FontWeight="Bold"/><TextBlock Text="Choose what happens after every capture." Foreground="{StaticResource Ink2}" Margin="0,4,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource Group}">
    <StackPanel>
     <TextBlock Style="{StaticResource GroupLabel}" Text="AFTER CAPTURE"/>
     <CheckBox x:Name="ActionsCheckbox" AutomationProperties.Name="Choose an action after selection"><StackPanel><TextBlock Text="Choose an action after selection" FontWeight="Bold"/><TextBlock Style="{StaticResource Hint}" Text="Screenshot, video or scrolling photo"/></StackPanel></CheckBox>
     <Border Style="{StaticResource Divider}"/>
     <CheckBox x:Name="SaveDialogCheckbox" AutomationProperties.Name="Show Save As"><StackPanel><TextBlock Text="Show Save As" FontWeight="Bold"/><TextBlock Style="{StaticResource Hint}" Text="Pick a name and folder after each screenshot"/></StackPanel></CheckBox>
     <Border Style="{StaticResource Divider}"/>
     <CheckBox x:Name="AutosaveCheckbox" AutomationProperties.Name="Save automatically"><StackPanel><TextBlock Text="Save automatically" FontWeight="Bold"/><TextBlock Style="{StaticResource Hint}" Text="Keep a file of each screenshot"/></StackPanel></CheckBox>
     <Border Style="{StaticResource Divider}"/>
     <CheckBox x:Name="ClipboardCheckbox" AutomationProperties.Name="Copy to clipboard"><StackPanel><TextBlock Text="Copy to clipboard" FontWeight="Bold"/><TextBlock Style="{StaticResource Hint}" Text="Ready to paste wherever you need it"/></StackPanel></CheckBox>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Group}">
    <StackPanel>
     <TextBlock Style="{StaticResource GroupLabel}" Text="SYSTEM"/>
     <CheckBox x:Name="StartupCheckbox" AutomationProperties.Name="Start with Windows"><StackPanel><TextBlock Text="Start with Windows" FontWeight="Bold"/><TextBlock Style="{StaticResource Hint}" Text="Launch into the tray when you sign in"/></StackPanel></CheckBox>
     <Border Style="{StaticResource Divider}"/>
     <CheckBox x:Name="PrintScreenCheckbox" AutomationProperties.Name="Take over Print Screen" Checked="PrintScreenCheckbox_Changed" Unchecked="PrintScreenCheckbox_Changed"><StackPanel><TextBlock Text="Take over Print Screen" FontWeight="Bold"/><TextBlock Style="{StaticResource Hint}" Text="Vibershot handles the key instead of Windows while it is running"/></StackPanel></CheckBox>
     <StackPanel x:Name="PrintScreenOptions" Margin="0,14,0,0">
      <RadioButton x:Name="PrintScreenToolRadio" GroupName="PrintScreen" Content="Open the region tool" Margin="0,0,0,10"/>
      <RadioButton x:Name="PrintScreenDesktopRadio" GroupName="PrintScreen" Content="Snap the full desktop right away"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Group}">
    <StackPanel>
     <TextBlock Style="{StaticResource GroupLabel}" Text="GALLERY"/>
     <TextBlock Text="Library root" FontWeight="Bold" Margin="0,0,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LibraryRootTextBox" AutomationProperties.Name="Library root" ToolTip="Gallery library root" FontFamily="{StaticResource MonoFont}" FontSize="12"/><Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="14,9" Click="LibraryBrowseButton_Click"/></Grid>
     <TextBlock Style="{StaticResource Hint}" Text="The gallery shows the save location plus Screenshots, Recordings and Projects under this root" Margin="0,6,0,0"/>
     <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Thumbnail size" FontWeight="Bold"/><TextBlock x:Name="ThumbnailSizeLabel" Grid.Column="1" Foreground="{StaticResource Ink2}" FontFamily="{StaticResource MonoFont}" FontSize="12"/></Grid>
     <Slider x:Name="ThumbnailSizeSlider" AutomationProperties.Name="Thumbnail size" Minimum="120" Maximum="360" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="40" Margin="0,8,0,0" ValueChanged="ThumbnailSizeSlider_ValueChanged"/>
     <Border Style="{StaticResource Divider}"/>
     <CheckBox x:Name="OpenGalleryCheckbox" AutomationProperties.Name="Open the gallery after each capture"><StackPanel><TextBlock Text="Open the gallery after each capture" FontWeight="Bold"/><TextBlock Style="{StaticResource Hint}" Text="Shows the new capture selected in the gallery instead of the preview"/></StackPanel></CheckBox>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Group}" Margin="0">
    <StackPanel>
     <TextBlock Style="{StaticResource GroupLabel}" Text="FILES"/>
     <TextBlock Text="Save location" FontWeight="Bold" Margin="0,0,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderTextBox" AutomationProperties.Name="Save location" ToolTip="Screenshot output folder" FontFamily="{StaticResource MonoFont}" FontSize="12"/><Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="14,9" Click="BrowseButton_Click"/></Grid>
     <TextBlock Text="Image format" FontWeight="Bold" Margin="0,18,0,8"/>
     <ComboBox x:Name="FormatComboBox" AutomationProperties.Name="Image format" SelectionChanged="FormatComboBox_SelectionChanged"><ComboBoxItem Content="PNG · lossless quality" Tag="{x:Static core:ImageFormat.Png}"/><ComboBoxItem Content="JPEG · smaller files" Tag="{x:Static core:ImageFormat.Jpeg}"/><ComboBoxItem Content="WebP lossless · exact pixels, smaller than PNG" Tag="{x:Static core:ImageFormat.WebpLossless}"/><ComboBoxItem Content="WebP · custom quality" Tag="{x:Static core:ImageFormat.Webp}"/></ComboBox>
     <StackPanel x:Name="WebpQualityPanel" Margin="0,16,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="WebP quality" FontWeight="Bold"/><TextBlock x:Name="WebpQualityLabel" Grid.Column="1" Foreground="{StaticResource Ink2}" FontFamily="{StaticResource MonoFont}" FontSize="12"/></Grid>
      <Slider x:Name="WebpQualitySlider" AutomationProperties.Name="WebP quality" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" Margin="0,8,0,0" ValueChanged="WebpQualitySlider_ValueChanged"/>
      <TextBlock Style="{StaticResource Hint}" Text="Lower is smaller; 80 is a good balance" Margin="0,6,0,0"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True" Width="94" Click="CancelButton_Click"/><Button Content="Save settings" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OkButton_Click"/></StackPanel>
 </Grid>
</Window>
