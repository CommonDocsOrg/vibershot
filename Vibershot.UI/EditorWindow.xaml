<Window x:Class="Vibershot.UI.EditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Vibershot.UI"
 Style="{StaticResource {x:Type Window}}" Title="Vibershot Editor" Width="1320" Height="860" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen" AllowDrop="True">
 <Window.Resources>
  <!-- Tool rail: 40px icon toggles; the active tool sits on a pale tangerine tile. -->
  <Style x:Key="ToolButton" TargetType="ToggleButton">
   <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0,0,0,4"/>
   <Setter Property="Foreground" Value="{StaticResource Ink2}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="16"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Shell" Background="Transparent" CornerRadius="9" BorderBrush="Transparent" BorderThickness="0">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource Hover}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource TangerineSoft}"/><Setter Property="Foreground" Value="{StaticResource Tangerine}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Tangerine}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Top bar icon buttons (undo, redo, zoom). -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Ink2}"/>
   <Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="Transparent" BorderThickness="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource Rule}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Tangerine}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Small text toggles in the properties panel (bold, italic, alignment). -->
  <Style x:Key="SmallToggle" TargetType="ToggleButton">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="Foreground" Value="{StaticResource Ink2}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Shell" Background="{StaticResource Paper}" CornerRadius="6" BorderBrush="{StaticResource PaperEdge}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource Hover}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource TangerineSoft}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource TangerineSoft}"/><Setter Property="Foreground" Value="{StaticResource Tangerine}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Tangerine}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="PanelLabel" TargetType="TextBlock" BasedOn="{StaticResource GroupLabel}"><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink2}"/><Setter Property="Margin" Value="0,10,0,6"/></Style>
  <Style x:Key="FieldValue" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="Foreground" Value="{StaticResource Ink3}"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,10,0,6"/></Style>
  <!-- Context menu in the paper style. -->
  <Style TargetType="ContextMenu">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource PaperEdge}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="8">
     <Border.Effect><DropShadowEffect Color="#14181C" BlurRadius="24" ShadowDepth="6" Opacity="0.16"/></Border.Effect>
     <ItemsPresenter/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="Shell" Padding="12,7" CornerRadius="6" Background="Transparent" MinWidth="200">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Ink3}" Margin="24,0,0,0" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource Hover}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{StaticResource Rule}" Margin="8,4"/></ControlTemplate></Setter.Value></Setter></Style>
  <DrawingBrush x:Key="Checkerboard" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
   <DrawingBrush.Drawing><DrawingGroup>
    <GeometryDrawing Brush="#F3F4F6"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,20,20"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Brush="#E6E8EC"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,10,10"/><RectangleGeometry Rect="10,10,10,10"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
   </DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- Top bar: document on the left, zoom in the middle, actions on the right. Export is the one tangerine element. -->
  <Grid Margin="22,0,20,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" MinWidth="200">
    <TextBlock x:Name="DocNameLabel" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
    <TextBlock x:Name="DocInfoLabel" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Ink2}" Margin="0,2,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out"/>
    <TextBlock x:Name="ZoomLabel" Text="100%" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource Ink2}" Width="52" TextAlignment="Center" VerticalAlignment="Center"/>
    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in"/>
    <Button Style="{StaticResource SmallButton}" Content="Fit" Click="Fit_Click" Margin="10,0,0,0" ToolTip="Fit the picture in the window (Ctrl+0)"/>
    <Button Style="{StaticResource SmallButton}" Content="100%" Click="ActualSize_Click" Margin="6,0,0,0" ToolTip="Show pixels 1:1 (Ctrl+1)"/>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"/>
    <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" Margin="2,0,14,0"/>
    <!-- File menu: the full set of document commands; the two most used also sit beside it. -->
    <Button x:Name="FileButton" Content="File ▾" Click="File_Click" Padding="14,8" ToolTip="Open, save and export">
     <Button.ContextMenu>
      <ContextMenu Placement="Bottom">
       <MenuItem Header="Open…" InputGestureText="Ctrl+O" Click="Open_Click"/>
       <Separator/>
       <MenuItem Header="Save project" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
       <MenuItem Header="Save project as…" InputGestureText="Ctrl+Shift+S" Click="SaveProjectAs_Click"/>
       <Separator/>
       <MenuItem Header="Export image…" InputGestureText="Ctrl+E" Click="Export_Click"/>
       <MenuItem Header="Copy image" Click="CopyImage_Click"/>
      </ContextMenu>
     </Button.ContextMenu>
    </Button>
    <Button Content="Save project" Click="SaveProject_Click" Padding="14,8" Margin="8,0,0,0" ToolTip="Keep every item editable (Ctrl+S)"/>
    <Button Content="Export image…" Style="{StaticResource PrimaryButton}" Click="Export_Click" Padding="20,8" Margin="8,0,0,0" ToolTip="Write a flat PNG, JPEG or WebP (Ctrl+E)"/>
   </StackPanel>
  </Grid>

  <!-- Flatten notice: shown after an export while the editable document has no project file or unsaved changes. -->
  <Border x:Name="FlattenNotice" Grid.Row="1" Visibility="Collapsed" Margin="22,0,20,10" Background="{StaticResource TangerineSoft}" BorderBrush="{StaticResource Tangerine}" BorderThickness="1" CornerRadius="8" Padding="14,8,8,8">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="FlattenNoticeText" Foreground="{StaticResource Ink}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Save project" Click="SaveProject_Click" Margin="14,0,4,0" VerticalAlignment="Center"/>
    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Click="DismissNotice_Click" ToolTip="Dismiss" AutomationProperties.Name="Dismiss notice" VerticalAlignment="Center"/>
   </Grid>
  </Border>

  <Grid Grid.Row="2" Margin="12,0,20,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="268"/></Grid.ColumnDefinitions>

   <!-- Tool rail -->
   <StackPanel x:Name="ToolRail" Margin="4,0,8,0" VerticalAlignment="Top">
    <ToggleButton Style="{StaticResource ToolButton}" Tag="Select" Content="&#xE7C9;" Click="Tool_Click" ToolTip="Select (V)" AutomationProperties.Name="Select tool"/>
    <ToggleButton Style="{StaticResource ToolButton}" Tag="Marquee" Content="&#xE8B3;" Click="Tool_Click" ToolTip="Marquee: select pixels to move, cut or copy (M)" AutomationProperties.Name="Marquee tool"/>
    <ToggleButton Style="{StaticResource ToolButton}" Tag="Crop" Content="&#xE7A8;" Click="Tool_Click" ToolTip="Crop (C)" AutomationProperties.Name="Crop tool"/>
    <Border Height="1" Background="{StaticResource Rule}" Margin="8,4,8,8"/>
    <ToggleButton Style="{StaticResource ToolButton}" Tag="Arrow" Content="&#xE72A;" Click="Tool_Click" ToolTip="Arrow (A)" AutomationProperties.Name="Arrow tool"/>
    <ToggleButton x:Name="ShapeToolButton" Style="{StaticResource ToolButton}" Tag="Shape" Click="Tool_Click" MouseRightButtonUp="ShapeTool_RightClick" ToolTip="Shape: rectangle, ellipse or line (S; press again to switch)" AutomationProperties.Name="Shape tool">
     <Grid Width="20" Height="20">
      <Path x:Name="ShapeToolIcon" Data="M2,4 H18 V16 H2 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
      <Path Data="M14,16 L17,19 L20,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" Margin="0,0,-6,-6" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
     </Grid>
    </ToggleButton>
    <Popup x:Name="ShapeFlyout" PlacementTarget="{Binding ElementName=ShapeToolButton}" Placement="Right" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="4">
     <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource PaperEdge}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="8">
      <Border.Effect><DropShadowEffect Color="#14181C" BlurRadius="24" ShadowDepth="6" Opacity="0.16"/></Border.Effect>
      <StackPanel Orientation="Horizontal">
       <ToggleButton Style="{StaticResource ToolButton}" Tag="Rect" Click="ShapeKind_Click" ToolTip="Rectangle" Margin="0,0,2,0"><Path Data="M2,4 H18 V16 H2 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8"/></ToggleButton>
       <ToggleButton Style="{StaticResource ToolButton}" Tag="Ellipse" Click="ShapeKind_Click" ToolTip="Ellipse" Margin="0,0,2,0"><Path Data="M10,3 A7,7 0 1 1 9.99,3 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8"/></ToggleButton>
       <ToggleButton Style="{StaticResource ToolButton}" Tag="Line" Click="ShapeKind_Click" ToolTip="Line" Margin="0"><Path Data="M3,17 L17,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></ToggleButton>
      </StackPanel>
     </Border>
    </Popup>
    <ToggleButton Style="{StaticResource ToolButton}" Tag="Text" Content="&#xE8D2;" Click="Tool_Click" ToolTip="Text (T)" AutomationProperties.Name="Text tool"/>
    <ToggleButton Style="{StaticResource ToolButton}" Tag="Image" Content="&#xEB9F;" Click="Tool_Click" ToolTip="Place an image file (I)" AutomationProperties.Name="Image tool"/>
   </StackPanel>

   <!-- Canvas on the checkerboard well. A Canvas above it hosts the in-place text editor. -->
   <Border Grid.Column="1" CornerRadius="12" BorderBrush="{StaticResource PaperEdge}" BorderThickness="1" Background="{StaticResource Checkerboard}" ClipToBounds="True">
    <Grid>
     <local:EditorCanvas x:Name="Surface" MouseDown="Surface_MouseDown" MouseMove="Surface_MouseMove" MouseUp="Surface_MouseUp" MouseWheel="Surface_MouseWheel" LostMouseCapture="Surface_LostMouseCapture" Cursor="Arrow">
      <local:EditorCanvas.ContextMenu>
       <ContextMenu Opened="ContextMenu_Opened">
        <MenuItem x:Name="CutMenu" Header="Cut" InputGestureText="Ctrl+X" Click="Cut_Click"/>
        <MenuItem x:Name="CopyMenu" Header="Copy" InputGestureText="Ctrl+C" Click="Copy_Click"/>
        <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="Paste_Click"/>
        <MenuItem x:Name="DuplicateMenu" Header="Duplicate" InputGestureText="Ctrl+D" Click="Duplicate_Click"/>
        <MenuItem x:Name="DeleteMenu" Header="Delete" InputGestureText="Del" Click="Delete_Click"/>
        <Separator/>
        <MenuItem x:Name="FrontMenu" Header="Bring to front" InputGestureText="Ctrl+Shift+]" Click="BringToFront_Click"/>
        <MenuItem x:Name="ForwardMenu" Header="Bring forward" InputGestureText="Ctrl+]" Click="BringForward_Click"/>
        <MenuItem x:Name="BackwardMenu" Header="Send backward" InputGestureText="Ctrl+[" Click="SendBackward_Click"/>
        <MenuItem x:Name="BackMenu" Header="Send to back" InputGestureText="Ctrl+Shift+[" Click="SendToBack_Click"/>
        <Separator/>
        <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
       </ContextMenu>
      </local:EditorCanvas.ContextMenu>
     </local:EditorCanvas>
     <Canvas x:Name="EditorLayer"/>
    </Grid>
   </Border>

   <!-- Properties panel -->
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,0,0,0">
    <StackPanel>
     <StackPanel x:Name="NoSelectionPanel">
      <TextBlock Style="{StaticResource PanelLabel}" Text="PROPERTIES"/>
      <TextBlock Text="Nothing selected" FontWeight="Bold"/>
      <TextBlock Style="{StaticResource Hint}" Text="Click an item to edit it, or pick a tool on the left and drag on the picture." TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel x:Name="ItemPanel" Visibility="Collapsed">
      <TextBlock x:Name="ItemKindLabel" Style="{StaticResource PanelLabel}" Text="RECTANGLE"/>
      <StackPanel x:Name="StrokeRow">
       <TextBlock Style="{StaticResource FieldLabel}" Text="Stroke" Margin="0,0,0,6"/>
       <local:ColorStrip x:Name="StrokeStrip" AllowNone="True"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FieldLabel}" Text="Width"/><TextBlock x:Name="StrokeWidthValue" Grid.Column="1" Style="{StaticResource FieldValue}"/></Grid>
       <Slider x:Name="StrokeWidthSlider" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StrokeWidth_Changed"/>
      </StackPanel>
      <StackPanel x:Name="FillRow">
       <TextBlock Style="{StaticResource FieldLabel}" Text="Fill"/>
       <local:ColorStrip x:Name="FillStrip" AllowNone="True"/>
      </StackPanel>
      <StackPanel x:Name="CornerRow">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FieldLabel}" Text="Corner radius"/><TextBlock x:Name="CornerValue" Grid.Column="1" Style="{StaticResource FieldValue}"/></Grid>
       <Slider x:Name="CornerSlider" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Corner_Changed"/>
      </StackPanel>
      <StackPanel x:Name="HeadRow">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FieldLabel}" Text="Arrow head"/><TextBlock x:Name="HeadValue" Grid.Column="1" Style="{StaticResource FieldValue}"/></Grid>
       <Slider x:Name="HeadSlider" Minimum="4" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Head_Changed"/>
      </StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FieldLabel}" Text="Opacity"/><TextBlock x:Name="OpacityValue" Grid.Column="1" Style="{StaticResource FieldValue}"/></Grid>
      <Slider x:Name="OpacitySlider" Minimum="5" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Opacity_Changed"/>
      <CheckBox x:Name="ShadowCheck" Margin="0,14,0,0" Click="Shadow_Click" AutomationProperties.Name="Drop shadow"><TextBlock Text="Drop shadow" FontWeight="Bold"/></CheckBox>
      <StackPanel x:Name="TextSection" Margin="0,18,0,0">
       <TextBlock Style="{StaticResource PanelLabel}" Text="TEXT"/>
       <ComboBox x:Name="FontCombo" SelectionChanged="Font_Changed" AutomationProperties.Name="Font family"/>
       <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBox x:Name="FontSizeBox" Padding="8,6" FontFamily="{StaticResource MonoFont}" FontSize="12" KeyDown="FontSize_KeyDown" LostFocus="FontSize_LostFocus" AutomationProperties.Name="Font size" ToolTip="Font size in pixels"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
         <ToggleButton x:Name="BoldToggle" Style="{StaticResource SmallToggle}" Content="B" FontWeight="Bold" Click="TextStyle_Click" ToolTip="Bold"/>
         <ToggleButton x:Name="ItalicToggle" Style="{StaticResource SmallToggle}" Content="I" FontStyle="Italic" FontFamily="Georgia" Click="TextStyle_Click" ToolTip="Italic"/>
         <ToggleButton x:Name="UnderlineToggle" Style="{StaticResource SmallToggle}" Click="TextStyle_Click" ToolTip="Underline"><TextBlock Text="U" TextDecorations="Underline"/></ToggleButton>
        </StackPanel>
       </Grid>
       <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <ToggleButton x:Name="AlignLeftToggle" Style="{StaticResource SmallToggle}" Content="&#xE8E4;" FontFamily="Segoe Fluent Icons" Tag="Left" Click="Align_Click" ToolTip="Align left"/>
        <ToggleButton x:Name="AlignCenterToggle" Style="{StaticResource SmallToggle}" Content="&#xE8E3;" FontFamily="Segoe Fluent Icons" Tag="Center" Click="Align_Click" ToolTip="Centre"/>
        <ToggleButton x:Name="AlignRightToggle" Style="{StaticResource SmallToggle}" Content="&#xE8E2;" FontFamily="Segoe Fluent Icons" Tag="Right" Click="Align_Click" ToolTip="Align right"/>
       </StackPanel>
       <TextBlock Style="{StaticResource FieldLabel}" Text="Text colour"/>
       <local:ColorStrip x:Name="TextColorStrip"/>
       <TextBlock Style="{StaticResource FieldLabel}" Text="Background"/>
       <local:ColorStrip x:Name="TextBackgroundStrip" AllowNone="True"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FieldLabel}" Text="Padding"/><TextBlock x:Name="PaddingValue" Grid.Column="1" Style="{StaticResource FieldValue}"/></Grid>
       <Slider x:Name="PaddingSlider" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Padding_Changed"/>
      </StackPanel>
     </StackPanel>
     <!-- Layers: top of the list is the top of the stack. Rows are built in code; the active layer sits on a pale tangerine tile. -->
     <StackPanel Margin="0,22,0,0">
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Style="{StaticResource PanelLabel}" Text="LAYERS" Margin="0" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE710;" Click="AddLayer_Click" ToolTip="New layer above the active one" AutomationProperties.Name="New layer"/>
        <Button x:Name="LayerUpButton" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE70E;" Click="LayerUp_Click" ToolTip="Move layer up" AutomationProperties.Name="Move layer up"/>
        <Button x:Name="LayerDownButton" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE70D;" Click="LayerDown_Click" ToolTip="Move layer down" AutomationProperties.Name="Move layer down"/>
        <Button x:Name="DeleteLayerButton" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE74D;" Click="DeleteLayer_Click" ToolTip="Delete layer" AutomationProperties.Name="Delete layer"/>
       </StackPanel>
      </Grid>
      <StackPanel x:Name="LayersList"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FieldLabel}" Text="Layer opacity"/><TextBlock x:Name="LayerOpacityValue" Grid.Column="1" Style="{StaticResource FieldValue}"/></Grid>
      <Slider x:Name="LayerOpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="LayerOpacity_Changed" AutomationProperties.Name="Layer opacity"/>
      <TextBlock Style="{StaticResource Hint}" Text="New items land on the active layer. Double-click a layer to rename it; right-click for more." TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
     <StackPanel Margin="0,22,0,16">
      <TextBlock Style="{StaticResource PanelLabel}" Text="PICTURE"/>
      <TextBlock x:Name="DocSizeLabel" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource Ink2}"/>
      <TextBlock Style="{StaticResource FieldLabel}" Text="Canvas"/>
      <local:ColorStrip x:Name="CanvasStrip" AllowNone="True" ToolTip="Colour under every layer; the crossed swatch keeps the canvas transparent"/>
      <TextBlock x:Name="CropHint" Style="{StaticResource Hint}" Text="Drag over the picture, then press Enter to crop. Esc cancels." TextWrapping="Wrap" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
       <Button x:Name="ApplyCropButton" Style="{StaticResource SmallButton}" Content="Apply crop" Click="ApplyCrop_Click" Visibility="Collapsed" Margin="0,0,6,0"/>
       <Button x:Name="ResetCropButton" Style="{StaticResource SmallButton}" Content="Reset crop" Click="ResetCrop_Click" IsEnabled="False"/>
      </StackPanel>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>

  <!-- Footer: status on the left, tool shortcuts on the right as mono data. -->
  <Grid Grid.Row="3" Margin="22,10,22,14">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Ink3}" Margin="0,1,7,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="StatusLabel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ink2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="700" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="V select · M marquee · C crop · A arrow · S shape · T text · I image · Space drag pans · Ctrl+wheel zooms" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Ink3}" VerticalAlignment="Center"/>
  </Grid>
