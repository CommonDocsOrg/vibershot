<Window x:Class="Vibershot.UI.VideoEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Vibershot.UI"
 Style="{StaticResource {x:Type Window}}" Title="Vibershot Video" Width="1440" Height="900" MinWidth="1040" MinHeight="640" WindowStartupLocation="CenterScreen" AllowDrop="True"
 Background="{StaticResource Well}">
 <Window.Resources>
  <!-- Rail icon and text buttons: the same shapes as the image editor's rail. -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Ink2}"/>
   <Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="7" BorderBrush="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource Hover}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource Rule}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RailTextButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Width" Value="Auto"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>
  <Style x:Key="RailToggle" TargetType="ToggleButton">
   <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,0"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Shell" Background="Transparent" CornerRadius="7" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource Hover}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentWash}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentEdge}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RailGlyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource Ink2}"/></Style>
  <Style x:Key="RailDivider" TargetType="Border"><Setter Property="Width" Value="1"/><Setter Property="Height" Value="22"/><Setter Property="Background" Value="{StaticResource Rule}"/><Setter Property="Margin" Value="6,0"/></Style>
  <Style x:Key="Keys" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="10.5"/><Setter Property="Foreground" Value="{StaticResource Ink3}"/><Setter Property="Margin" Value="7,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="PanelLabel" TargetType="TextBlock" BasedOn="{StaticResource GroupLabel}"><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Ink2}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="FieldValue" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Menu"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition x:Name="TimelineRow" Height="300" MinHeight="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- Menu bar. -->
  <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="8,0,14,0" Height="32">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource AccentFill}" Margin="4,0,8,0" VerticalAlignment="Center"><Polygon Points="6,4.5 13,9 6,13.5" Fill="{StaticResource AccentInk}"/></Border>
     <Menu IsMainMenu="True">
      <MenuItem Header="_File">
       <MenuItem Header="New project" InputGestureText="Ctrl+N" Click="New_Click"/>
       <MenuItem Header="Open project…" InputGestureText="Ctrl+O" Click="Open_Click"/>
       <MenuItem Header="Import media…" InputGestureText="Ctrl+I" Click="Import_Click"/>
       <MenuItem Header="Import captions (SRT)…" Click="ImportCaptions_Click"/>
       <MenuItem Header="Export captions (SRT)…" Click="ExportCaptions_Click"/>
       <Separator/>
       <MenuItem Header="Save project" InputGestureText="Ctrl+S" Click="Save_Click"/>
       <MenuItem Header="Save project as…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
       <Separator/>
       <MenuItem Header="Export MP4…" InputGestureText="Ctrl+E" Click="Export_Click"/>
       <Separator/>
       <MenuItem Header="Close" InputGestureText="Ctrl+W" Click="Close_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit" SubmenuOpened="EditMenu_Opened">
       <MenuItem x:Name="UndoMenu" Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
       <MenuItem x:Name="RedoMenu" Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
       <Separator/>
       <MenuItem x:Name="SplitMenu" Header="Split at playhead" InputGestureText="S" Click="Split_Click"/>
       <MenuItem x:Name="DeleteMenu" Header="Delete" InputGestureText="Del" Click="Delete_Click"/>
       <MenuItem x:Name="RippleMenu" Header="Ripple delete" InputGestureText="Shift+Del" Click="RippleDelete_Click"/>
       <MenuItem x:Name="DetachMenu" Header="Detach audio" Click="Detach_Click"/>
       <Separator/>
       <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
       <MenuItem Header="Zoom timeline in" InputGestureText="+" Click="ZoomIn_Click"/>
       <MenuItem Header="Zoom timeline out" InputGestureText="-" Click="ZoomOut_Click"/>
       <MenuItem Header="Fit timeline" InputGestureText="\" Click="ZoomFit_Click"/>
      </MenuItem>
      <MenuItem Header="_Track">
       <MenuItem Header="Add video track" Click="AddVideoTrack_Click"/>
       <MenuItem Header="Add audio track" Click="AddAudioTrack_Click"/>
       <MenuItem Header="Add caption track" Click="AddCaptionTrack_Click"/>
       <Separator/>
       <MenuItem Header="Add caption at playhead" InputGestureText="T" Click="AddCaption_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
       <MenuItem Header="Keyboard shortcuts…" Click="Shortcuts_Click"/>
      </MenuItem>
     </Menu>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="DocNameLabel" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="360" VerticalAlignment="Center"/>
     <TextBlock x:Name="DocInfoLabel" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Ink2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- Action rail. Export is the one full-strength accent. -->
  <Border Grid.Row="1" Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="10,0,12,0" Height="46">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Click="Open_Click" ToolTip="Open a project (Ctrl+O)" AutomationProperties.Name="Open project"/>
     <Button Style="{StaticResource IconButton}" Content="&#xE74E;" Click="Save_Click" ToolTip="Save project (Ctrl+S)" AutomationProperties.Name="Save project"/>
     <Border Style="{StaticResource RailDivider}"/>
     <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"/>
     <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"/>
     <Border Style="{StaticResource RailDivider}"/>
     <Button Style="{StaticResource RailTextButton}" Click="Import_Click" ToolTip="Add MP4 videos and pictures to the project (Ctrl+I)" AutomationProperties.Name="Import media"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RailGlyph}" Text="&#xE710;"/><TextBlock Text="Import media"/></StackPanel></Button>
     <Border Style="{StaticResource RailDivider}"/>
     <ToggleButton x:Name="SelectToolButton" Style="{StaticResource RailToggle}" IsChecked="True" Click="SelectTool_Click" ToolTip="Select, move and trim clips (V)" AutomationProperties.Name="Select tool"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RailGlyph}" Text="&#xE8B0;"/><TextBlock Text="Select"/><TextBlock Style="{StaticResource Keys}" Text="V"/></StackPanel></ToggleButton>
     <ToggleButton x:Name="RazorToolButton" Style="{StaticResource RailToggle}" Click="RazorTool_Click" ToolTip="Click a clip to cut it there (C)" AutomationProperties.Name="Razor tool"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RailGlyph}" Text="&#xE8C6;"/><TextBlock Text="Razor"/><TextBlock Style="{StaticResource Keys}" Text="C"/></StackPanel></ToggleButton>
     <Button x:Name="SplitButton" Style="{StaticResource RailTextButton}" Click="Split_Click" ToolTip="Cut the clips under the playhead (S)" AutomationProperties.Name="Split at playhead"><StackPanel Orientation="Horizontal"><TextBlock Text="Split at playhead"/><TextBlock Style="{StaticResource Keys}" Text="S"/></StackPanel></Button>
     <Button x:Name="RippleButton" Style="{StaticResource RailTextButton}" Click="RippleDelete_Click" ToolTip="Delete the selection and close the gap (Shift+Del)" AutomationProperties.Name="Ripple delete"><TextBlock Text="Ripple delete"/></Button>
     <Button x:Name="AddCaptionButton" Style="{StaticResource RailTextButton}" Click="AddCaption_Click" ToolTip="Add a caption at the playhead (T)" AutomationProperties.Name="Add caption"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RailGlyph}" Text="&#xED1E;"/><TextBlock Text="Caption"/><TextBlock Style="{StaticResource Keys}" Text="T"/></StackPanel></Button>
     <Border Style="{StaticResource RailDivider}"/>
     <ToggleButton x:Name="SnapButton" Style="{StaticResource RailToggle}" IsChecked="True" Click="Snap_Click" ToolTip="Snap clips and the playhead to clip edges, and moved pictures to the canvas (N). Hold Alt to snap off while dragging." AutomationProperties.Name="Snap"><TextBlock Text="Snap"/></ToggleButton>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="QualityButton" Style="{StaticResource RailTextButton}" Click="Quality_Click" ToolTip="Preview resolution and proxies. Export always uses the original files." AutomationProperties.Name="Preview quality">
      <StackPanel Orientation="Horizontal"><Ellipse x:Name="ProxyDot" Width="8" Height="8" Fill="{StaticResource Ink3}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="QualityLabel" Text="Preview: Auto"/><TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center" Foreground="{StaticResource Ink2}"/></StackPanel>
     </Button>
     <Button Content="Export MP4…" Style="{StaticResource PrimaryButton}" Click="Export_Click" Padding="16,7" Margin="10,0,0,0" FontSize="12.5" ToolTip="Render the timeline to an MP4 (Ctrl+E)"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="268"/><ColumnDefinition/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>

   <!-- Left: project media. -->
   <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0">
    <Grid Margin="14,12,10,10">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <RadioButton x:Name="MediaTab" GroupName="LeftTab" Style="{StaticResource RailToggle}" Height="28" IsChecked="True" Checked="LeftTab_Changed" ToolTip="The files this project uses" AutomationProperties.Name="Media tab"><TextBlock x:Name="BinLabel" Text="Media"/></RadioButton>
      <RadioButton x:Name="ElementsTab" GroupName="LeftTab" Style="{StaticResource RailToggle}" Height="28" Checked="LeftTab_Changed" Content="Elements" ToolTip="Text, callouts, shapes, arrows and stamps to put over the video" AutomationProperties.Name="Elements tab"/>
     </StackPanel>
     <ListBox x:Name="Bin" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Bin_DoubleClick" PreviewMouseLeftButtonDown="Bin_MouseDown" PreviewMouseMove="Bin_MouseMove" AutomationProperties.Name="Project media">
      <ListBox.ContextMenu>
       <ContextMenu Opened="BinMenu_Opened">
        <MenuItem x:Name="BinAddEnd" Header="Add after the last clip" Click="BinAddEnd_Click"/>
        <MenuItem x:Name="BinAddTop" Header="Place on top at the playhead" Click="BinAddTop_Click"/>
        <MenuItem x:Name="BinAddAudio" Header="Add only its sound at the playhead" Click="BinAddAudio_Click"/>
       </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Width" Value="112"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="Shell" CornerRadius="7" Padding="3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"><ContentPresenter/></Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource Hover}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentWash}"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel ToolTip="{Binding Path}">
         <Grid Height="60">
          <Border CornerRadius="5" Background="{StaticResource Well}" ClipToBounds="True"><Image Source="{Binding Thumb}" Stretch="UniformToFill"/></Border>
          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3" Padding="5,1" CornerRadius="4" Background="#CC191A21"><TextBlock Text="{Binding Length}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="White"/></Border>
          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3" Padding="5,1" CornerRadius="4" Background="#CC191A21"><TextBlock Text="{Binding Badge}" FontSize="10" Foreground="White"/></Border>
          <ProgressBar Height="3" VerticalAlignment="Bottom" Minimum="0" Maximum="1" Value="{Binding ProxyProgress}" Visibility="{Binding ProxyVisibility}" Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0"/>
         </Grid>
         <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="2,4,2,0"/>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <ScrollViewer x:Name="ElementsScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel x:Name="ElementsHost" Margin="0,0,6,0"/>
     </ScrollViewer>
     <Border Grid.Row="2" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,8,4,0">
      <TextBlock x:Name="LeftHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Drag a file onto the timeline, or onto the picture to lay it over what is there. Double-click adds a video after the last clip and a still on top at the playhead."/>
     </Border>
    </Grid>
   </Border>

   <!-- Centre: the picture and the transport under it. -->
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <local:VideoPreview x:Name="Preview"/>
    <!-- Shown over a text graphic while its words are edited in place. -->
    <TextBox x:Name="InlineWords" Visibility="Collapsed" TextOptions.TextFormattingMode="Ideal" HorizontalAlignment="Left" VerticalAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="1" BorderBrush="{StaticResource Accent}" Padding="0" TextChanged="Words_Changed" LostKeyboardFocus="InlineWords_LostFocus" PreviewKeyDown="Words_KeyDown" AutomationProperties.Name="Edit text in place">
     <!-- A bare template: the themed text box's own padding and corners would shift the words off the ones drawn underneath. -->
     <TextBox.Template><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/></Border></ControlTemplate></TextBox.Template>
    </TextBox>
    <Border Grid.Row="1" Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Height="44" Padding="14,0">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock x:Name="TimeLabel" Text="0:00:00" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
       <TextBlock x:Name="DurationLabel" Text="/ 0:00:00" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Ink3}" Margin="8,1,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="GoStart_Click" ToolTip="Go to the start (Home)" AutomationProperties.Name="Go to start"/>
       <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="StepBack_Click" ToolTip="Back one frame (, or Left)" AutomationProperties.Name="Previous frame"/>
       <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Width="40" Content="&#xE768;" Click="Play_Click" ToolTip="Play or pause (Space)" AutomationProperties.Name="Play"/>
       <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Click="StepForward_Click" ToolTip="Forward one frame (. or Right)" AutomationProperties.Name="Next frame"/>
       <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="GoEnd_Click" ToolTip="Go to the end (End)" AutomationProperties.Name="Go to end"/>
      </StackPanel>
      <TextBlock x:Name="PreviewInfoLabel" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Ink3}"/>
     </Grid>
    </Border>
   </Grid>

   <!-- Right: the selected clip, or the project when nothing is selected. -->
   <Border Grid.Column="2" Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="14,12,14,14">
      <TextBlock x:Name="PropTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="PropSubtitle" Style="{StaticResource Hint}" Margin="0,2,0,12" TextWrapping="Wrap"/>
      <StackPanel x:Name="ProjectPanel">
       <TextBlock Style="{StaticResource PanelLabel}" Text="PROJECT"/>
       <Grid Margin="0,0,0,6"><TextBlock Style="{StaticResource FieldLabel}" Text="Canvas"/><TextBlock x:Name="ProjectSizeValue" Style="{StaticResource FieldValue}"/></Grid>
       <Grid Margin="0,0,0,6"><TextBlock Style="{StaticResource FieldLabel}" Text="Frame rate"/><TextBlock x:Name="ProjectRateValue" Style="{StaticResource FieldValue}"/></Grid>
       <Grid Margin="0,0,0,6"><TextBlock Style="{StaticResource FieldLabel}" Text="Length"/><TextBlock x:Name="ProjectLengthValue" Style="{StaticResource FieldValue}"/></Grid>
       <Grid Margin="0,0,0,6"><TextBlock Style="{StaticResource FieldLabel}" Text="Tracks"/><TextBlock x:Name="ProjectTracksValue" Style="{StaticResource FieldValue}"/></Grid>
      </StackPanel>
      <StackPanel x:Name="ClipPanel" Visibility="Collapsed">
       <TextBlock Style="{StaticResource PanelLabel}" Text="TIMING"/>
       <Grid Margin="0,0,0,6"><TextBlock Style="{StaticResource FieldLabel}" Text="Start"/><TextBlock x:Name="ClipStartValue" Style="{StaticResource FieldValue}"/></Grid>
       <Grid Margin="0,0,0,6"><TextBlock Style="{StaticResource FieldLabel}" Text="Length"/><TextBlock x:Name="ClipLengthValue" Style="{StaticResource FieldValue}"/></Grid>
       <Grid Margin="0,0,0,6"><TextBlock Style="{StaticResource FieldLabel}" Text="Source in"/><TextBlock x:Name="ClipSourceValue" Style="{StaticResource FieldValue}"/></Grid>
       <StackPanel x:Name="FadePanel">
        <Grid><TextBlock Style="{StaticResource FieldLabel}" Text="Fade in (frames)"/><local:ValueBox x:Name="FadeInBox" Minimum="0" Maximum="1000000" Suffix="" AutomationProperties.Name="Fade in" ToolTip="Frames over which the clip comes in from nothing; also the round handle at the clip's top left corner on the timeline"/></Grid>
        <Grid><TextBlock Style="{StaticResource FieldLabel}" Text="Fade out (frames)"/><local:ValueBox x:Name="FadeOutBox" Minimum="0" Maximum="1000000" Suffix="" AutomationProperties.Name="Fade out" ToolTip="Frames over which the clip goes out to nothing; also the round handle at the clip's top right corner on the timeline"/></Grid>
       </StackPanel>
       <StackPanel x:Name="WordsPanel" Margin="0,10,0,0">
        <Border Style="{StaticResource Divider}" Margin="0,0,0,12"/>
        <TextBlock x:Name="WordsLabel" Style="{StaticResource PanelLabel}" Text="TEXT"/>
        <TextBox x:Name="WordsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="160" VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="12.5" TextChanged="Words_Changed" PreviewKeyDown="Words_KeyDown" AutomationProperties.Name="Words"/>
        <Grid Margin="0,4,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Size"/><local:ValueBox x:Name="FontSizeBox" Minimum="4" Maximum="2000" Suffix="" AutomationProperties.Name="Font size"/></Grid>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
         <ToggleButton x:Name="BoldButton" Style="{StaticResource RailToggle}" Height="28" Width="34" Padding="0" Content="B" FontWeight="Bold" Checked="TextStyle_Changed" Unchecked="TextStyle_Changed" ToolTip="Bold" AutomationProperties.Name="Bold"/>
         <ToggleButton x:Name="ItalicButton" Style="{StaticResource RailToggle}" Height="28" Width="34" Padding="0" Content="I" FontStyle="Italic" Checked="TextStyle_Changed" Unchecked="TextStyle_Changed" ToolTip="Italic" AutomationProperties.Name="Italic"/>
         <ComboBox x:Name="AlignBox" Width="96" Margin="8,0,0,0" SelectionChanged="TextStyle_Changed" AutomationProperties.Name="Text alignment"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Centre"/><ComboBoxItem Content="Right"/></ComboBox>
        </StackPanel>
        <CheckBox x:Name="CaptionTopCheck" Content="Show captions at the top" Margin="0,10,0,0" Click="CaptionTop_Click"/>
        <TextBlock Style="{StaticResource FieldLabel}" Text="Text colour" Margin="0,12,0,6"/>
        <local:ColorStrip x:Name="TextColour"/>
        <TextBlock Style="{StaticResource FieldLabel}" Text="Box behind the text" Margin="0,10,0,6"/>
        <local:ColorStrip x:Name="BackColour" AllowNone="True"/>
        <TextBlock x:Name="CaptionNote" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" Text="Size, colours and position apply to every caption on this track."/>
       </StackPanel>
       <StackPanel x:Name="ShapePanel" Margin="0,10,0,0">
        <Border Style="{StaticResource Divider}" Margin="0,0,0,12"/>
        <TextBlock Style="{StaticResource PanelLabel}" Text="LINE AND FILL"/>
        <TextBlock Style="{StaticResource FieldLabel}" Text="Line colour" Margin="0,0,0,6"/>
        <local:ColorStrip x:Name="StrokeColour" AllowNone="True"/>
        <Grid Margin="0,4,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Line width"/><local:ValueBox x:Name="StrokeWidthBox" Minimum="0" Maximum="400" Suffix="" Decimals="1" AutomationProperties.Name="Line width"/></Grid>
        <TextBlock x:Name="FillLabel" Style="{StaticResource FieldLabel}" Text="Fill colour" Margin="0,10,0,6"/>
        <local:ColorStrip x:Name="FillColour" AllowNone="True"/>
       </StackPanel>
       <StackPanel x:Name="PicturePanel" Margin="0,10,0,0">
        <Border Style="{StaticResource Divider}" Margin="0,0,0,12"/>
        <TextBlock x:Name="PictureLabel" Style="{StaticResource PanelLabel}" Text="PICTURE"/>
        <Grid><TextBlock Style="{StaticResource FieldLabel}" Text="Position"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><local:ValueBox x:Name="PlaceX" Suffix="" Minimum="-16000" Maximum="16000" AutomationProperties.Name="Picture X" ToolTip="Left edge, in canvas pixels"/><local:ValueBox x:Name="PlaceY" Suffix="" Minimum="-16000" Maximum="16000" Margin="6,6,0,2" AutomationProperties.Name="Picture Y" ToolTip="Top edge, in canvas pixels"/></StackPanel></Grid>
        <Grid><TextBlock Style="{StaticResource FieldLabel}" Text="Size"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><local:ValueBox x:Name="PlaceW" Suffix="" Minimum="8" Maximum="16000" AutomationProperties.Name="Picture width" ToolTip="Width, in canvas pixels"/><local:ValueBox x:Name="PlaceH" Suffix="" Minimum="8" Maximum="16000" Margin="6,6,0,2" AutomationProperties.Name="Picture height" ToolTip="Height, in canvas pixels"/></StackPanel></Grid>
        <Grid><TextBlock Style="{StaticResource FieldLabel}" Text="Rotation"/><local:ValueBox x:Name="PlaceRotation" Minimum="-360" Maximum="360" Suffix="°" Decimals="1" AutomationProperties.Name="Picture rotation"/></Grid>
        <Grid Margin="0,8,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Opacity"/><TextBlock x:Name="OpacityValue" Style="{StaticResource FieldValue}"/></Grid>
        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,6,0,10" ValueChanged="Opacity_Changed" AutomationProperties.Name="Opacity"/>
        <WrapPanel x:Name="PictureButtons">
         <Button Content="Fit" Click="Fit_Click" Padding="12,6" Margin="0,0,6,6" ToolTip="Show the whole picture inside the canvas"/>
         <Button Content="Fill" Click="Fill_Click" Padding="12,6" Margin="0,0,6,6" ToolTip="Cover the canvas, cropping what overhangs"/>
         <ToggleButton x:Name="CropButton" Style="{StaticResource RailToggle}" Content="Crop" Checked="Crop_Click" Unchecked="Crop_Click" Height="30" Margin="0,0,6,6" ToolTip="Drag the picture's edges in the preview to cut them away (or double-click the picture)" AutomationProperties.Name="Crop picture"/>
         <Button Content="Reset" Click="ResetPlacement_Click" Padding="12,6" Margin="0,0,0,6" ToolTip="Back to fitted, upright, uncropped and fully opaque"/>
        </WrapPanel>
        <TextBlock x:Name="PictureHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Drag the picture in the preview to move it, its handles to resize or turn it. Shift frees the shape on a corner and snaps the turn to 15°."/>
       </StackPanel>
       <StackPanel x:Name="AudioPanel" Margin="0,10,0,0">
        <Border Style="{StaticResource Divider}" Margin="0,0,0,12"/>
        <TextBlock Style="{StaticResource PanelLabel}" Text="AUDIO"/>
        <Grid><TextBlock Style="{StaticResource FieldLabel}" Text="Volume"/><TextBlock x:Name="VolumeValue" Style="{StaticResource FieldValue}"/></Grid>
        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" Margin="0,6,0,10" ValueChanged="Volume_Changed" AutomationProperties.Name="Volume"/>
        <CheckBox x:Name="MuteCheck" Content="Mute this clip" Click="Mute_Click"/>
       </StackPanel>
       <Button x:Name="DetachButton" Content="Detach audio" Click="Detach_Click" Margin="0,14,0,0" HorizontalAlignment="Left" Padding="12,7" ToolTip="Let the picture and its sound move and trim separately"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>

  <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource Rule}" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Cursor="SizeNS" AutomationProperties.Name="Resize timeline"/>

  <!-- Timeline with its horizontal scroll bar. -->
  <Grid Grid.Row="4" Background="{StaticResource Well}">
   <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="TimelineHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <local:TimelineView x:Name="Timeline" VerticalAlignment="Top" AutomationProperties.Name="Timeline"/>
   </ScrollViewer>
   <ScrollBar x:Name="TimelineScroll" Grid.Row="1" Orientation="Horizontal" Margin="148,0,0,0" ValueChanged="TimelineScroll_Changed"/>
  </Grid>

  <!-- Status bar. -->
  <Border Grid.Row="5" Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Height="26" Padding="12,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Ink3}" Margin="0,0,8,0" VerticalAlignment="Center"/>
     <TextBlock x:Name="StatusLabel" FontSize="11.5" Foreground="{StaticResource Ink2}" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <TextBlock x:Name="ZoomLabel" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Ink3}" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>
