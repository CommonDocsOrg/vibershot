<Window x:Class="Vibershot.UI.UpdateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Vibershot update" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Well}">
 <Grid Margin="28,24,28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Image Source="/Assets/logo.png" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock x:Name="TitleText" Text="A new version is ready" FontSize="20" FontWeight="Bold"/>
    <TextBlock x:Name="VersionText" Foreground="{StaticResource Ink2}" Margin="0,4,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>

  <Border Grid.Row="1" Style="{StaticResource Group}" x:Name="NotesCard">
   <StackPanel>
    <TextBlock Text="What changed" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,6"/>
    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
     <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12.5"/>
    </ScrollViewer>
    <TextBlock x:Name="ReleaseLinkText" FontSize="12" Margin="0,8,0,0"><Hyperlink x:Name="ReleaseLink" Click="ReleaseLink_Click" AutomationProperties.Name="Open the release page">Open the release page</Hyperlink></TextBlock>
   </StackPanel>
  </Border>

  <StackPanel Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,4,0,0">
   <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
   <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" AutomationProperties.Name="Download progress"/>
  </StackPanel>
  <ContentControl Grid.Row="2" x:Name="ErrorHost" Focusable="False" Margin="0,4,0,0"/>

  <Grid Grid.Row="3" Margin="0,18,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="SkipButton" Style="{StaticResource LinkButton}" Content="Skip this version" AutomationProperties.Name="Skip this version" HorizontalAlignment="Left" Click="Skip_Click"/>
   <Button x:Name="LaterButton" Grid.Column="1" Content="Later" Width="94" AutomationProperties.Name="Install later" Click="Later_Click"/>
   <Button x:Name="InstallButton" Grid.Column="2" Content="Install and restart" Style="{StaticResource PrimaryButton}" IsDefault="True" AutomationProperties.Name="Install and restart" Padding="18,10" Margin="10,0,0,0" Click="Install_Click"/>
  </Grid>
 </Grid>
</Window>
