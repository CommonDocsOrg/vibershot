<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <RootNamespace>Vibershot.Editing</RootNamespace>
  </PropertyGroup>

  <!-- WPF types only (BitmapSource, DrawingContext, Rect, Color); this library opens no windows. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <!-- The video project model uses FrameRate and builds export plans for Vibershot.Media. -->
  <ItemGroup>
    <ProjectReference Include="..\Vibershot.Media\Vibershot.Media.csproj" />
  </ItemGroup>

</Project>
